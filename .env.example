# ─────────────────────────────────────────────────────────────────────────────
# ExpenseTracker Environment Configuration (.env)
# Note: Use double underscores (__) so ASP.NET Core maps them to config sections
# You can paste this directly into Render -> Environment -> "Add from .env"
# ─────────────────────────────────────────────────────────────────────────────

# 1. MySQL 8 Connection String (for Aiven / cloud MySQL, keep SslMode=Required;)
ConnectionStrings__DefaultConnection="Server=localhost;Port=3306;Database=expensetracker;User=root;Password=devpassword;"

# 2. Admin Account Credentials (use Admin__Password or pre-computed Admin__PasswordHash)
Admin__Email="admin@example.com"
Admin__Password="ChangeMe123!"

# 3. Runtime & Port (Render routes traffic to PORT=8080 inside the .NET container)
ASPNETCORE_ENVIRONMENT="Production"
PORT="8080"

