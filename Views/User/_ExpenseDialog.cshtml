@model ExpensesViewModel
@{
    var editing = Model.Expense.Id != 0;
    // Saving returns to the page it was opened from; after a rejected save, to where the first attempt came from.
    var returnUrl = Context.Request.HasFormContentType ? Context.Request.Form["returnUrl"].ToString() : $"{Context.Request.Path}{Context.Request.QueryString}";
}

@* Opened by any [data-expense] button (site.js), which also fills it in for an edit. *@
<dialog id="expense-dialog" class="sheet" aria-labelledby="expense-dialog-title">
    <form asp-controller="User" asp-action="Expenses" method="post">
        <div class="modal__header">
            <div>
                <p class="eyebrow" id="expense-dialog-eyebrow">@(editing ? "Update expense" : "New expense")</p>
                <h2 id="expense-dialog-title">@(editing ? "Edit expense" : "Add an expense")</h2>
            </div>
            <button type="button" class="button button--icon" aria-label="Close" onclick="this.closest('dialog').close()">
                <svg class="i"><use href="#i-close" /></svg>
            </button>
        </div>
        <partial name="_ExpenseFields" />
        <input type="hidden" name="returnUrl" value="@returnUrl" />
        <div class="modal__actions">
            <button type="button" class="button button--secondary" onclick="this.closest('dialog').close()">Cancel</button>
            <button type="submit" class="button button--primary">@(editing ? "Save changes" : "Save expense")</button>
        </div>
    </form>
</dialog>
