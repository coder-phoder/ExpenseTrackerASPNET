@model ChangePasswordViewModel

<section class="panel" style="padding:1.75rem 1.85rem">
    <div class="panel__header">
        <h2>Change password</h2>
    </div>

    <form asp-action="ChangePassword" method="post" class="mt-2">
        <label class="field">
            <span>Current password</span>
            <input asp-for="CurrentPassword" autocomplete="current-password" placeholder="••••••••" />
            <span asp-validation-for="CurrentPassword" class="text-danger small d-block mt-1"></span>
        </label>

        <div class="form-row">
            <label class="field">
                <span>New password</span>
                <input asp-for="NewPassword" autocomplete="new-password" placeholder="••••••••" />
                <span asp-validation-for="NewPassword" class="text-danger small d-block mt-1"></span>
            </label>

            <label class="field">
                <span>Confirm password</span>
                <input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
            </label>
        </div>

        <div style="display:flex;justify-content:flex-end;margin-top:1.35rem;padding-top:1.15rem;border-top:1px solid var(--line-soft)">
            <button type="submit" class="button button--primary">Update password</button>
        </div>
    </form>
</section>
