@using System.Globalization
@using System.Security.Claims
@model (DateOnly Month, List<Expense> Expenses)
@{
    ViewData["Title"] = $"Monthly Report {Model.Month:MMMM yyyy}";
    var first = Model.Month;
    var daysInMonth = DateTime.DaysInMonth(first.Year, first.Month);
    var last = new DateOnly(first.Year, first.Month, daysInMonth);
    var prevMonth = first.AddMonths(-1);
    var nextMonth = first.AddMonths(1);
    var prevIso = prevMonth.ToString("yyyy-MM");
    var nextIso = nextMonth.ToString("yyyy-MM");
    var currentMonthIso = first.ToString("yyyy-MM");

    var count = Model.Expenses.Count;
    var total = Model.Expenses.Sum(e => e.Price ?? 0m);
    var safeTotal = Math.Max(1m, total);
    var activeDays = Model.Expenses.Select(e => e.Date).Distinct().Count();
    var dailyAvg = daysInMonth > 0 ? Math.Round(total / daysInMonth) : 0m;
    var avgTicket = count > 0 ? Math.Round(total / count) : 0m;

    var onlineSpent = Model.Expenses.Where(e => e.PaymentMode != PaymentMode.Cash).Sum(e => e.Price ?? 0m);
    var cashSpent = total - onlineSpent;
    var onlinePct = total > 0 ? (int)Math.Round(onlineSpent / safeTotal * 100m) : 0;

    var byCategory = Model.Expenses.GroupBy(e => e.Category)
        .Select(g => (Name: g.Key, Count: g.Count(), Amount: g.Sum(e => e.Price ?? 0m)))
        .OrderByDescending(c => c.Amount)
        .ToList();

    var byMode = Model.Expenses.GroupBy(e => e.PaymentMode)
        .Select(g => (Mode: g.Key.DisplayName(), Count: g.Count(), Amount: g.Sum(e => e.Price ?? 0m)))
        .OrderByDescending(m => m.Amount)
        .ToList();

    var biggest = Model.Expenses.OrderByDescending(e => e.Price ?? 0m).FirstOrDefault();
    var userName = User.Identity?.Name ?? "Account Holder";
    var userEmail = User.FindFirstValue(ClaimTypes.Email) ?? "";
    string[] palette = ["var(--coral)", "var(--mint)", "var(--blue)", "var(--sand)", "var(--ink)", "#9f7ab8"];
    string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);
}

<div class="st-toolbar d-print-none">
    <div class="st-toolbar__nav">
        <a asp-action="Statement" asp-route-month="@prevIso"
           class="btn btn-outline-secondary st-nav-btn"
           title="Previous month (@prevMonth.ToString("MMMM yyyy"))"
           aria-label="Previous month: @prevMonth.ToString("MMMM yyyy")">&lsaquo;</a>

        <form asp-action="Statement" method="get" class="st-toolbar__form">
            <input type="month"
                   name="month"
                   value="@currentMonthIso"
                   class="form-control st-month-input"
                   aria-label="Statement month"
                   onchange="this.form.submit()"
                   required />
        </form>

        <a asp-action="Statement" asp-route-month="@nextIso"
           class="btn btn-outline-secondary st-nav-btn"
           title="Next month (@nextMonth.ToString("MMMM yyyy"))"
           aria-label="Next month: @nextMonth.ToString("MMMM yyyy")">&rsaquo;</a>
    </div>
    <div class="st-toolbar__actions">
        <a asp-action="ExportCsv" asp-route-from="@first.ToString("yyyy-MM-dd")" asp-route-to="@last.ToString("yyyy-MM-dd")"
           asp-route-sort="date_asc" class="btn btn-outline-secondary">
            <svg class="i"><use href="#i-download" /></svg><span>Download CSV</span>
        </a>
        <button type="button" class="btn btn-primary" onclick="print()">
            <svg class="i"><use href="#i-receipt" /></svg><span>Save as PDF</span>
        </button>
    </div>
</div>

<article class="st-sheet">
    <header class="st-head">
        <div class="st-brand-block">
            <div class="st-brand">
                <span class="st-brand__mark"><i></i><i></i><i></i></span>
                <span class="st-brand__name">Spendy</span>
                <span class="st-badge">Statement of Expenses</span>
            </div>
            <h1 class="st-title">@first.ToString("MMMM yyyy")</h1>
            <p class="st-period num">@first.ToString("dd MMM yyyy") — @last.ToString("dd MMM yyyy")</p>
        </div>

        <dl class="st-meta">
            <div>
                <dt>Prepared for</dt>
                <dd>@userName</dd>
            </div>
            @if (!string.IsNullOrEmpty(userEmail))
            {
                <div>
                    <dt>Account</dt>
                    <dd>@userEmail</dd>
                </div>
            }
            <div>
                <dt>Statement ref</dt>
                <dd class="num">SPD-@first.ToString("yyyyMM")</dd>
            </div>
            <div>
                <dt>Issued on</dt>
                <dd class="num">@DateTime.Today.ToString("dd MMM yyyy")</dd>
            </div>
        </dl>
    </header>

    <section class="st-kpis">
        <div class="st-kpi st-kpi--primary">
            <span class="st-kpi__label">Total spent</span>
            <strong class="st-kpi__val num">@total.ToString("C")</strong>
            <span class="st-kpi__sub num">@count @(count == 1 ? "transaction" : "transactions") recorded</span>
        </div>
        <div class="st-kpi">
            <span class="st-kpi__label">Daily average</span>
            <strong class="st-kpi__val num">@dailyAvg.ToString("C0")</strong>
            <span class="st-kpi__sub num">@activeDays of @daysInMonth active days</span>
        </div>
        <div class="st-kpi">
            <span class="st-kpi__label">Average ticket</span>
            <strong class="st-kpi__val num">@avgTicket.ToString("C0")</strong>
            <span class="st-kpi__sub num">@(biggest is not null ? $"Peak: {biggest.Price?.ToString("C0")}" : "No activity")</span>
        </div>
        <div class="st-kpi">
            <span class="st-kpi__label">Payment split</span>
            <strong class="st-kpi__val num">@onlinePct% Online</strong>
            <span class="st-kpi__sub num">@onlineSpent.ToString("C0") digital · @cashSpent.ToString("C0") cash</span>
        </div>
    </section>

    @if (count == 0)
    {
        <div class="st-empty">
            <p>No expenses were recorded during @first.ToString("MMMM yyyy").</p>
        </div>
    }
    else
    {
        <section class="st-split">
            <div class="st-box">
                <div class="st-box__head">
                    <h2>Category breakdown</h2>
                    <span class="num">@byCategory.Count @(byCategory.Count == 1 ? "category" : "categories")</span>
                </div>

                <div class="st-stack" role="img" aria-label="Category share bar">
                    @for (var i = 0; i < byCategory.Count; i++)
                    {
                        var c = byCategory[i];
                        var pct = Math.Max(2.0, (double)(c.Amount / safeTotal) * 100.0);
                        <span style="flex: @F(pct); background: @palette[i % palette.Length]"></span>
                    }
                </div>

                <div class="st-cat-rows">
                    @for (var i = 0; i < byCategory.Count; i++)
                    {
                        var c = byCategory[i];
                        var share = (double)(c.Amount / safeTotal) * 100.0;
                        <div class="st-cat-row">
                            <span class="st-dot" style="background: @palette[i % palette.Length]"></span>
                            <span class="st-cat-row__name">@c.Name <small class="num">(@c.Count)</small></span>
                            <span class="st-cat-row__pct num">@share.ToString("0.#")%</span>
                            <strong class="st-cat-row__amt num">@c.Amount.ToString("C")</strong>
                        </div>
                    }
                </div>
            </div>

            <div class="st-box">
                <div class="st-box__head">
                    <h2>Payment channels</h2>
                    <span class="num">@byMode.Count @(byMode.Count == 1 ? "mode" : "modes")</span>
                </div>

                <div class="st-mode-rows">
                    @foreach (var m in byMode)
                    {
                        var pct = (int)Math.Round(m.Amount / safeTotal * 100m);
                        <div class="st-mode-row">
                            <div class="st-mode-row__top">
                                <strong>@m.Mode</strong>
                                <span class="num">@m.Count @(m.Count == 1 ? "tx" : "txs") · @pct% · <b>@m.Amount.ToString("C")</b></span>
                            </div>
                            <div class="st-bar"><span style="width: @Math.Max(4, pct)%"></span></div>
                        </div>
                    }
                </div>

                @if (biggest is not null)
                {
                    <div class="st-highlight">
                        <span>Largest expense</span>
                        <div>
                            <strong>@biggest.Title</strong>
                            <small>@biggest.Category · @biggest.Date.ToString("dd MMM yyyy") · @biggest.PaymentMode.DisplayName()</small>
                        </div>
                        <b class="num">@biggest.Price?.ToString("C")</b>
                    </div>
                }
            </div>
        </section>

        <section class="st-ledger">
            <div class="st-box__head">
                <h2>Itemized transaction ledger</h2>
                <span class="num">Chronological · @count @(count == 1 ? "entry" : "entries")</span>
            </div>

            <table class="st-table">
                <thead>
                    <tr>
                        <th class="st-col-idx">#</th>
                        <th>Date</th>
                        <th>Particulars</th>
                        <th>Category</th>
                        <th>Channel</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.Expenses.Count; i++)
                    {
                        var e = Model.Expenses[i];
                        <tr>
                            <td class="st-col-idx num">@((i + 1).ToString("00"))</td>
                            <td class="text-nowrap num">@e.Date.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="st-tx-title">@e.Title</div>
                                @if (!string.IsNullOrEmpty(e.Description))
                                {
                                    <div class="st-tx-desc">@e.Description</div>
                                }
                            </td>
                            <td><span class="st-pill">@e.Category</span></td>
                            <td class="text-nowrap st-muted">@e.PaymentMode.DisplayName()</td>
                            <td class="text-end text-nowrap num fw-semibold">@e.Price?.ToString("C")</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5">Total for @first.ToString("MMMM yyyy") (@count @(count == 1 ? "expense" : "expenses"))</td>
                        <td class="text-end num">@total.ToString("C")</td>
                    </tr>
                </tfoot>
            </table>
        </section>
    }

    <footer class="st-foot">
        <span>Spendy Personal Finance · Automated Monthly Statement</span>
        <span class="num">All figures in INR (₹) · Ref SPD-@first.ToString("yyyyMM")</span>
    </footer>
</article>
