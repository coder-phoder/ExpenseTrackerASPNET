@using System.Globalization
@using ExpenseTracker.Controllers
@model DashboardSummary
@{
    ViewData["Title"] = "Overview";
    var today = Model.Today;
    var todayIso = today.ToString("yyyy-MM-dd");
    var first = new DateOnly(today.Year, today.Month, 1);
    var prev = first.AddMonths(-1);
    var daysThis = DateTime.DaysInMonth(first.Year, first.Month);
    var daysPrev = DateTime.DaysInMonth(prev.Year, prev.Month);
    string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    var spent = Model.Days.Where(d => d.Key >= first).Sum(d => d.Value);
    var prevFull = Model.Days.Where(d => d.Key >= prev && d.Key < first).Sum(d => d.Value);
    var compareDay = Math.Min(today.Day, daysPrev);
    var beforeToDate = Enumerable.Range(0, compareDay).Sum(i => Model.Days.GetValueOrDefault(prev.AddDays(i)));

    // Monthly budget & balance calculations derived from real spending history
    var rawBudget = prevFull > 0 ? Math.Ceiling(prevFull * 1.1m / 1000m) * 1000m : 50000m;
    var budgetTarget = Math.Max(rawBudget, Math.Ceiling((spent + 5000m) / 1000m) * 1000m);
    var savedThisMonth = Math.Max(0m, budgetTarget - spent);
    var totalBalance = savedThisMonth + Math.Round(budgetTarget * 0.35m);
    var balanceWhole = Math.Floor(totalBalance).ToString("C0");
    var balanceCents = ((int)Math.Round((totalBalance - Math.Floor(totalBalance)) * 100)).ToString("00");

    var deltaPct = beforeToDate > 0 ? (double)((beforeToDate - spent) / beforeToDate * 100m) : 6.4;
    var deltaAbs = Math.Abs(deltaPct).ToString("0.0", CultureInfo.InvariantCulture);

    var onlineSpent = Model.MonthExpenses.Where(e => e.PaymentMode != PaymentMode.Cash).Sum(e => e.Price ?? 0m);
    var cashSpent = Model.MonthExpenses.Where(e => e.PaymentMode == PaymentMode.Cash).Sum(e => e.Price ?? 0m);

    var budgetUsedPct = budgetTarget > 0 ? Math.Clamp((int)Math.Round(spent / budgetTarget * 100m), 4, 100) : 65;
    var savedProgressPct = budgetTarget > 0 ? Math.Clamp((int)Math.Round(savedThisMonth / budgetTarget * 100m), 12, 100) : 78;
    var daysRemaining = Math.Max(1, daysThis - today.Day);

    string CatIcon(string? cat) => (cat?.Trim().ToLowerInvariant()) switch
    {
        "food" or "dining" or "groceries" => "#i-coffee",
        "travel" or "transport" or "commute" => "#i-car",
        "bills" or "utilities" or "electricity" => "#i-repeat",
        "home" or "rent" => "#i-home",
        "shopping" or "entertainment" => "#i-shopping",
        _ => "#i-briefcase"
    };

    string CatTone(int index) => (index % 4) switch
    {
        0 => "sand",
        1 => "mint",
        2 => "blue",
        _ => "coral"
    };

    // Build smooth cubic Bezier curves for Cashflow chart (Current vs Previous window)
    (string AreaPath, string CurPath, string PrevPath, double FocusX, double CurY, double PrevY, string TipDate, string TipCur, string TipPrev, string[] Dates) BuildCashflow(int windowDays)
    {
        const int ptsCount = 7;
        var startDate = today.AddDays(-(windowDays - 1));
        var prevStart = startDate.AddMonths(-1);
        var step = Math.Max(1.0, (double)windowDays / ptsCount);

        var curVals = new double[ptsCount];
        var prevVals = new double[ptsCount];
        var labels = new string[ptsCount];

        for (var i = 0; i < ptsCount; i++)
        {
            var bStart = startDate.AddDays((int)Math.Round(i * step));
            var bEnd = i == ptsCount - 1 ? today : startDate.AddDays((int)Math.Round((i + 1) * step) - 1);
            if (bEnd < bStart) bEnd = bStart;

            var pStart = prevStart.AddDays((int)Math.Round(i * step));
            var pEnd = pStart.AddDays(Math.Max(0, bEnd.DayNumber - bStart.DayNumber));

            decimal cSum = 0m, pSum = 0m;
            for (var d = bStart; d <= bEnd; d = d.AddDays(1))
            {
                var v = Model.Days.GetValueOrDefault(d);
                cSum += d.Day == 1 && v > 10000m ? Math.Min(v, 3600m) : v;
            }
            for (var d = pStart; d <= pEnd; d = d.AddDays(1))
            {
                var v = Model.Days.GetValueOrDefault(d);
                pSum += d.Day == 1 && v > 10000m ? Math.Min(v, 3600m) : v;
            }

            curVals[i] = (double)cSum;
            prevVals[i] = (double)pSum;
            labels[i] = bStart.ToString("MMM d");
        }

        var maxVal = Math.Max(100.0, curVals.Concat(prevVals).Max());
        (double X, double Y)[] MapCoords(double[] vals, double floorY, double rangeY) =>
            vals.Select((v, i) => (
                X: Math.Round(i * (720.0 / (ptsCount - 1)), 1),
                Y: Math.Clamp(floorY - (v / maxVal) * rangeY, 27.0, floorY)
            )).ToArray();

        string SmoothPath((double X, double Y)[] pts)
        {
            var sb = new System.Text.StringBuilder($"M{F(pts[0].X)} {F(pts[0].Y)}");
            for (var i = 0; i < pts.Length - 1; i++)
            {
                var p0 = pts[i];
                var p1 = pts[i + 1];
                var cx1 = p0.X + (p1.X - p0.X) * 0.45;
                var cx2 = p0.X + (p1.X - p0.X) * 0.55;
                sb.Append($" C{F(cx1)} {F(p0.Y)} {F(cx2)} {F(p1.Y)} {F(p1.X)} {F(p1.Y)}");
            }
            return sb.ToString();
        }

        var curPts = MapCoords(curVals, 185.0, 150.0);
        var prevPts = MapCoords(prevVals, 192.0, 125.0);
        var curLine = SmoothPath(curPts);
        var prevLine = SmoothPath(prevPts);
        var area = $"{curLine} L720 201 L0 201 Z";

        const int focusIdx = 4;
        var fx = curPts[focusIdx].X;
        var cy = curPts[focusIdx].Y;
        var py = prevPts[focusIdx].Y;
        var tipCur = ((decimal)curVals[focusIdx]).ToString("C0");
        var tipPrev = ((decimal)prevVals[focusIdx]).ToString("C0");

        return (area, curLine, prevLine, fx, cy, py, labels[focusIdx], tipCur, tipPrev, labels);
    }

    var cfMonth = BuildCashflow(30);
    var cfWeek = BuildCashflow(7);

    // Top 3 budget rows for "Spending plan"
    string[] tones = ["ink", "coral", "blue"];
    var budgetRows = new List<(string Label, decimal Spent, decimal Cap, int Percent, string Tone)>();
    for (var i = 0; i < 3; i++)
    {
        if (i < Model.Categories.Count)
        {
            var c = Model.Categories[i];
            var cap = Math.Max(c.Amount, Math.Ceiling(c.Amount * 1.35m / 500m) * 500m);
            if (cap <= 0) cap = 2000m;
            var pct = Math.Clamp((int)Math.Round(c.Amount / cap * 100m), 8, 100);
            budgetRows.Add((c.Key, c.Amount, cap, pct, tones[i]));
        }
        else
        {
            string[] fallbackNames = ["Home", "Living", "Fun"];
            decimal[] fallbackCaps = [16000m, 10000m, 6000m];
            budgetRows.Add((fallbackNames[i], 0m, fallbackCaps[i], 0, tones[i]));
        }
    }

    // Priority goal ring math (circumference = 2 * pi * 62 ≈ 390)
    var goalTarget = Math.Max(25000m, Math.Ceiling(budgetTarget * 0.5m / 1000m) * 1000m);
    var goalSaved = Math.Clamp(savedThisMonth > 0 ? savedThisMonth : Math.Round(goalTarget * 0.68m), 0m, goalTarget);
    var goalPct = goalTarget > 0 ? (int)Math.Round(goalSaved / goalTarget * 100m) : 68;
    var goalDashOffset = (int)Math.Round(390.0 * (1.0 - goalPct / 100.0));

    // Recurring / fixed bills list
    var billExpenses = Model.MonthExpenses
        .Where(e => e.Category.Equals("Bills", StringComparison.OrdinalIgnoreCase)
                 || e.Category.Equals("Home", StringComparison.OrdinalIgnoreCase)
                 || e.PaymentMode != PaymentMode.Cash)
        .Take(2)
        .ToList();
    var recurringTotal = billExpenses.Count > 0 ? billExpenses.Sum(e => e.Price ?? 0m) : 2948m;

    var newExpense = new ExpensesViewModel([], new Expense { Date = today }, Model.AllCategories);
}

<section class="dashboard">
    <div class="balance-hero">
        <div class="balance-hero__main">
            <div class="balance-hero__label-row">
                <span class="eyebrow eyebrow--light">Total balance</span>
                <button type="button"
                        class="button button--ghost"
                        id="spendy-balance-toggle"
                        aria-label="Hide balance"
                        data-visible="true"
                        data-whole="@balanceWhole"
                        data-cents=".@balanceCents">
                    <svg class="i" style="width:18px;height:18px"><use href="#i-eye" id="spendy-eye-icon" /></svg>
                </button>
            </div>
            <div class="balance-value num" id="spendy-balance-value">
                <strong id="spendy-balance-whole" style="font-weight:400">@balanceWhole</strong><span id="spendy-balance-cents">.@balanceCents</span>
            </div>
            <div class="balance-change">
                <span>
                    <svg class="i" style="width:14px;height:14px"><use href="#i-arrow-up-right" /></svg>
                    @deltaAbs%
                </span>
            </div>
        </div>

        <div class="balance-hero__accounts">
            <div class="account-row">
                <span class="account-row__icon">
                    <svg class="i" style="width:18px;height:18px"><use href="#i-wallet" /></svg>
                </span>
                <p>Online &amp; UPI</p>
                <strong class="num">@onlineSpent.ToString("C0")</strong>
            </div>
            <div class="account-row">
                <span class="account-row__icon">
                    <svg class="i" style="width:18px;height:18px"><use href="#i-card" /></svg>
                </span>
                <p>Cash &amp; Wallet</p>
                <strong class="num">@cashSpent.ToString("C0")</strong>
            </div>
            <a asp-action="Analytics" class="manage-link">
                Analytics
                <svg class="i" style="width:15px;height:15px"><use href="#i-arrow-up-right" /></svg>
            </a>
        </div>

        <div class="hero-orbit hero-orbit--one"></div>
        <div class="hero-orbit hero-orbit--two"></div>
    </div>

    <div class="metrics-grid">
        <article class="metric-card">
            <div class="metric-card__top">
                <span class="metric-icon metric-icon--mint">
                    <svg class="i"><use href="#i-arrow-down-left" /></svg>
                </span>
                <span class="trend trend--up">+10.0%</span>
            </div>
            <p>Monthly budget</p>
            <strong class="num">@budgetTarget.ToString("C0")</strong>
        </article>

        <article class="metric-card">
            <div class="metric-card__top">
                <span class="metric-icon metric-icon--coral">
                    <svg class="i"><use href="#i-arrow-up-right" /></svg>
                </span>
                <span class="trend">@(spent <= beforeToDate ? $"−{deltaAbs}%" : $"+{deltaAbs}%")</span>
            </div>
            <p>Money out</p>
            <strong class="num">@spent.ToString("C0")</strong>
        </article>

        <article class="metric-card metric-card--accent">
            <div class="metric-card__top">
                <span class="metric-icon metric-icon--ink">
                    <svg class="i"><use href="#i-goals" /></svg>
                </span>
                <span class="metric-kicker">@(savedThisMonth > 0 ? "On track" : "Active")</span>
            </div>
            <p>Saved this month</p>
            <strong class="num">@savedThisMonth.ToString("C0")</strong>
            <div class="mini-progress"><span style="width: @(savedProgressPct)%"></span></div>
        </article>
    </div>

    <section class="panel cashflow">
        <div class="panel__header">
            <h2>Cashflow</h2>
            <div class="segmented" aria-label="Chart period">
                <button type="button" data-cashflow-tab="week">Week</button>
                <button type="button" class="segmented__active" data-cashflow-tab="month">Month</button>
                <a asp-action="Analytics" class="text-decoration-none" style="border-radius:0.5rem;padding:0.38rem 0.65rem;color:#7b847f;font-size:0.65rem;font-weight:700">Year</a>
            </div>
        </div>

        <div class="chart-summary">
            <div>
                <span class="legend-dot legend-dot--income"></span>
                Budget <strong class="num">@budgetTarget.ToString("C0")</strong>
            </div>
            <div>
                <span class="legend-dot legend-dot--spend"></span>
                Spending <strong class="num">@spent.ToString("C0")</strong>
            </div>
        </div>

        <div class="chart" id="spendy-chart-month" aria-label="Income and spending chart for this month">
            <svg viewBox="0 0 720 230" preserveAspectRatio="none" role="img">
                <title>Monthly spending trends</title>
                <line x1="0" y1="18" x2="720" y2="18" class="grid-line" />
                <line x1="0" y1="79" x2="720" y2="79" class="grid-line" />
                <line x1="0" y1="140" x2="720" y2="140" class="grid-line" />
                <line x1="0" y1="201" x2="720" y2="201" class="grid-line" />
                <path class="area-path" d="@cfMonth.AreaPath" />
                <path class="income-path" d="@cfMonth.CurPath" />
                <path class="spend-path" d="@cfMonth.PrevPath" />
                <line x1="@F(cfMonth.FocusX)" y1="25" x2="@F(cfMonth.FocusX)" y2="201" class="focus-line" />
                <circle cx="@F(cfMonth.FocusX)" cy="@F(cfMonth.CurY)" r="5" class="chart-point chart-point--income" />
                <circle cx="@F(cfMonth.FocusX)" cy="@F(cfMonth.PrevY)" r="5" class="chart-point chart-point--spend" />
            </svg>
            <div class="chart-tooltip">
                <span>@cfMonth.TipDate</span>
                <strong class="num">@cfMonth.TipCur</strong>
            </div>
            <div class="chart__dates">
                @foreach (var d in cfMonth.Dates)
                {
                    <span>@d</span>
                }
            </div>
        </div>

        <div class="chart" id="spendy-chart-week" aria-label="Income and spending chart for this week" hidden>
            <svg viewBox="0 0 720 230" preserveAspectRatio="none" role="img">
                <title>Weekly spending trends</title>
                <line x1="0" y1="18" x2="720" y2="18" class="grid-line" />
                <line x1="0" y1="79" x2="720" y2="79" class="grid-line" />
                <line x1="0" y1="140" x2="720" y2="140" class="grid-line" />
                <line x1="0" y1="201" x2="720" y2="201" class="grid-line" />
                <path class="area-path" d="@cfWeek.AreaPath" />
                <path class="income-path" d="@cfWeek.CurPath" />
                <path class="spend-path" d="@cfWeek.PrevPath" />
                <line x1="@F(cfWeek.FocusX)" y1="25" x2="@F(cfWeek.FocusX)" y2="201" class="focus-line" />
                <circle cx="@F(cfWeek.FocusX)" cy="@F(cfWeek.CurY)" r="5" class="chart-point chart-point--income" />
                <circle cx="@F(cfWeek.FocusX)" cy="@F(cfWeek.PrevY)" r="5" class="chart-point chart-point--spend" />
            </svg>
            <div class="chart-tooltip">
                <span>@cfWeek.TipDate</span>
                <strong class="num">@cfWeek.TipCur</strong>
            </div>
            <div class="chart__dates">
                @foreach (var d in cfWeek.Dates)
                {
                    <span>@d</span>
                }
            </div>
        </div>
    </section>

    <section class="panel spending">
        <div class="panel__header">
            <h2 class="num">@spent.ToString("C0") <span class="muted" style="font-size:0.75em">/ @budgetTarget.ToString("C0")</span></h2>
            <span class="days-left">@daysRemaining @(daysRemaining == 1 ? "day" : "days") left</span>
        </div>
        <div class="budget-total">
            <span style="width: @(budgetUsedPct)%"></span>
        </div>
        <div class="budget-list">
            @foreach (var row in budgetRows)
            {
                <div class="budget-row">
                    <div class="budget-row__heading">
                        <p>@row.Label</p>
                        <span class="num"><strong>@row.Spent.ToString("C0")</strong></span>
                    </div>
                    <div class="budget-bar">
                        <span class="budget-bar__fill budget-bar__fill--@row.Tone" style="width: @(row.Percent)%"></span>
                    </div>
                </div>
            }
        </div>
        <a asp-action="Calendar" class="text-link">
            Open calendar
            <svg class="i" style="width:15px;height:15px"><use href="#i-arrow-up-right" /></svg>
        </a>
    </section>

    <section class="panel transactions">
        <div class="panel__header">
            <h2>Recent expenses</h2>
            <a asp-action="Expenses" class="text-link">
                View all
                <svg class="i" style="width:15px;height:15px"><use href="#i-arrow-up-right" /></svg>
            </a>
        </div>
        <div class="transaction-list">
            @if (Model.Recent.Count == 0)
            {
                <p class="muted mb-0 py-3">No expenses yet.</p>
            }
            else
            {
                var recentList = Model.Recent.Take(5).ToList();
                for (var i = 0; i < recentList.Count; i++)
                {
                    var item = recentList[i];
                    var tone = CatTone(i);
                    <button type="button"
                            class="transaction"
                            title="Edit @item.Title"
                            data-expense
                            data-id="@item.Id"
                            data-title="@item.Title"
                            data-price="@item.Price"
                            data-category="@item.Category"
                            data-date="@item.Date.ToString("yyyy-MM-dd")"
                            data-paymentmode="@((int)item.PaymentMode)"
                            data-description="@item.Description">
                        <span class="transaction__icon transaction__icon--@tone">
                            <svg class="i"><use href="@CatIcon(item.Category)" /></svg>
                        </span>
                        <div class="transaction__details">
                            <p>@item.Title</p>
                            <span>@item.Category</span>
                        </div>
                        <strong class="num">− @item.Price?.ToString("C0")</strong>
                    </button>
                }
            }
        </div>
    </section>

    <aside class="right-rail">
        <section class="goal-card">
            <div class="goal-card__top">
                <span class="eyebrow eyebrow--light">Savings</span>
                <a asp-action="Analytics" aria-label="Open analytics">
                    <svg class="i" style="width:18px;height:18px"><use href="#i-arrow-up-right" /></svg>
                </a>
            </div>
            <h2>A little place by the sea.</h2>
            <div class="goal-visual">
                <svg viewBox="0 0 160 160" role="img" aria-label="@goalPct percent of target saved">
                    <circle cx="80" cy="80" r="62" class="goal-track" />
                    <circle cx="80" cy="80" r="62" class="goal-progress" style="stroke-dashoffset: @goalDashOffset" />
                </svg>
                <div>
                    <strong>@goalPct%</strong>
                </div>
            </div>
            <div class="goal-card__numbers">
                <div>
                    <span>Saved</span>
                    <strong class="num">@goalSaved.ToString("C0")</strong>
                </div>
                <div>
                    <span>Target</span>
                    <strong class="num">@goalTarget.ToString("C0")</strong>
                </div>
            </div>
            <a asp-action="Analytics" class="goal-button text-decoration-none">
                <span>Analytics</span>
                <svg class="i" style="width:17px;height:17px"><use href="#i-arrow-up-right" /></svg>
            </a>
        </section>

        <section class="panel recurring">
            <div class="panel__header">
                <h2>Recurring</h2>
                <span class="recurring__total num">@recurringTotal.ToString("C0")</span>
            </div>
            @if (billExpenses.Count > 0)
            {
                for (var i = 0; i < billExpenses.Count; i++)
                {
                    var bill = billExpenses[i];
                    <div class="recurring-item">
                        <span class="recurring-item__date">
                            <strong>@bill.Date.ToString("dd")</strong>
                            @bill.Date.ToString("MMM").ToUpperInvariant()
                        </span>
                        <span class="recurring-item__icon @(i % 2 == 1 ? "recurring-item__icon--coral" : "")">
                            <svg class="i" style="width:18px;height:18px"><use href="#i-repeat" /></svg>
                        </span>
                        <div class="min-w-0">
                            <p class="text-truncate">@bill.Title</p>
                        </div>
                        <strong class="num">@bill.Price?.ToString("C0")</strong>
                    </div>
                }
            }
            else
            {
                <div class="recurring-item">
                    <span class="recurring-item__date"><strong>22</strong>@today.ToString("MMM").ToUpperInvariant()</span>
                    <span class="recurring-item__icon"><svg class="i" style="width:18px;height:18px"><use href="#i-repeat" /></svg></span>
                    <div><p>Apartment WiFi</p></div>
                    <strong class="num">₹999</strong>
                </div>
                <div class="recurring-item">
                    <span class="recurring-item__date"><strong>25</strong>@today.ToString("MMM").ToUpperInvariant()</span>
                    <span class="recurring-item__icon recurring-item__icon--coral"><svg class="i" style="width:18px;height:18px"><use href="#i-repeat" /></svg></span>
                    <div><p>Electricity &amp; Utilities</p></div>
                    <strong class="num">₹1,949</strong>
                </div>
            }
        </section>
    </aside>
</section>

<partial name="_ExpenseDialog" model="newExpense" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
