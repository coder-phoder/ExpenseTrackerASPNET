@using System.Globalization
@using ExpenseTracker.Controllers
@model DashboardSummary
@{
    ViewData["Title"] = "Overview";
    var today = Model.Today;
    var todayIso = today.ToString("yyyy-MM-dd");
    var first = new DateOnly(today.Year, today.Month, 1);
    var prev = first.AddMonths(-1);
    var daysThis = DateTime.DaysInMonth(first.Year, first.Month);
    var daysPrev = DateTime.DaysInMonth(prev.Year, prev.Month);
    string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    var spent = Model.Days.Where(d => d.Key >= first).Sum(d => d.Value);
    var prevFull = Model.Days.Where(d => d.Key >= prev && d.Key < first).Sum(d => d.Value);
    var todaySpent = Model.Days.GetValueOrDefault(today);
    var dailyAvg = today.Day > 0 ? Math.Round(spent / today.Day) : 0m;
    var compareDay = Math.Min(today.Day, daysPrev);
    var beforeToDate = Enumerable.Range(0, compareDay).Sum(i => Model.Days.GetValueOrDefault(prev.AddDays(i)));

    var spentWhole = Math.Floor(spent).ToString("C0");
    var spentCents = ((int)Math.Round((spent - Math.Floor(spent)) * 100)).ToString("00");

    var deltaPct = beforeToDate > 0 ? (double)((spent - beforeToDate) / beforeToDate * 100m) : 0.0;
    var deltaAbs = Math.Abs(deltaPct).ToString("0.0", CultureInfo.InvariantCulture);

    var onlineSpent = Model.MonthExpenses.Where(e => e.PaymentMode != PaymentMode.Cash).Sum(e => e.Price ?? 0m);
    var cashSpent = Model.MonthExpenses.Where(e => e.PaymentMode == PaymentMode.Cash).Sum(e => e.Price ?? 0m);

    string CatIcon(string? cat) => (cat?.Trim().ToLowerInvariant()) switch
    {
        "food" or "dining" or "groceries" => "#i-coffee",
        "travel" or "transport" or "commute" => "#i-car",
        "bills" or "utilities" or "electricity" => "#i-repeat",
        "home" or "rent" => "#i-home",
        "shopping" or "entertainment" => "#i-shopping",
        _ => "#i-briefcase"
    };

    string CatTone(int index) => (index % 4) switch
    {
        0 => "sand",
        1 => "mint",
        2 => "blue",
        _ => "coral"
    };

    // Current month daily histogram (1..daysThis)
    var dailyBars = Enumerable.Range(1, daysThis)
        .Select(d => {
            var date = first.AddDays(d - 1);
            return (Day: d, Date: date, Amount: Model.Days.GetValueOrDefault(date));
        })
        .ToArray();
    var maxDaily = Math.Max(1m, dailyBars.Max(b => b.Amount));

    // Current month weekly histogram (4 or 5 weeks)
    var weekCount = (daysThis + 6) / 7;
    var weeklyBars = Enumerable.Range(0, weekCount)
        .Select(w => {
            var sDay = w * 7 + 1;
            var eDay = Math.Min(daysThis, (w + 1) * 7);
            var amt = dailyBars.Skip(sDay - 1).Take(eDay - sDay + 1).Sum(b => b.Amount);
            return (Label: $"Week {w + 1}", Range: $"{sDay}–{eDay} {first:MMM}", StartDay: sDay, EndDay: eDay, Amount: amt);
        })
        .ToArray();
    var maxWeekly = Math.Max(1m, weeklyBars.Max(b => b.Amount));

    // All expenses this month sorted in decreasing order of amount
    var monthByPriceDesc = Model.MonthExpenses
        .OrderByDescending(e => e.Price ?? 0m)
        .ThenByDescending(e => e.Date)
        .ToList();
    var biggestExpenses = monthByPriceDesc.Take(3).ToList();

    var newExpense = new ExpensesViewModel([], new Expense { Date = today }, Model.AllCategories);
}

<section class="dashboard">
    <div class="balance-hero">
        <div class="balance-hero__main">
            <div class="balance-hero__label-row">
                <span class="eyebrow eyebrow--light">Spent this month</span>
                <button type="button"
                        class="button button--ghost"
                        id="spendy-balance-toggle"
                        aria-label="Hide amount"
                        data-visible="true"
                        data-whole="@spentWhole"
                        data-cents=".@spentCents">
                    <svg class="i" style="width:18px;height:18px"><use href="#i-eye" id="spendy-eye-icon" /></svg>
                </button>
            </div>
            <div class="balance-value num" id="spendy-balance-value">
                <strong id="spendy-balance-whole" style="font-weight:400">@spentWhole</strong><span id="spendy-balance-cents">.@spentCents</span>
            </div>
            <div class="balance-change">
                @if (beforeToDate > 0)
                {
                    <span>
                        <svg class="i" style="width:14px;height:14px"><use href="@(spent <= beforeToDate ? "#i-arrow-down-left" : "#i-arrow-up-right")" /></svg>
                        @deltaAbs% @(spent <= beforeToDate ? "less than last month" : "more than last month")
                    </span>
                }
                else
                {
                    <span>@Model.MonthExpenses.Count @(Model.MonthExpenses.Count == 1 ? "expense" : "expenses") this month</span>
                }
            </div>
        </div>

        <div class="balance-hero__accounts">
            <div class="account-row">
                <span class="account-row__icon">
                    <svg class="i" style="width:18px;height:18px"><use href="#i-wallet" /></svg>
                </span>
                <p>Paid online</p>
                <strong class="num">@onlineSpent.ToString("C0")</strong>
            </div>
            <div class="account-row">
                <span class="account-row__icon">
                    <svg class="i" style="width:18px;height:18px"><use href="#i-card" /></svg>
                </span>
                <p>Paid in cash</p>
                <strong class="num">@cashSpent.ToString("C0")</strong>
            </div>
            <a asp-action="Analytics" class="manage-link">
                See charts
                <svg class="i" style="width:15px;height:15px"><use href="#i-arrow-up-right" /></svg>
            </a>
        </div>

        <div class="hero-orbit hero-orbit--one"></div>
        <div class="hero-orbit hero-orbit--two"></div>
    </div>

    <div class="metrics-grid">
        <article class="metric-card">
            <div class="metric-card__top">
                <span class="metric-icon metric-icon--mint">
                    <svg class="i"><use href="#i-arrow-up-right" /></svg>
                </span>
                <span class="trend">Today</span>
            </div>
            <p>Spent today</p>
            <strong class="num">@todaySpent.ToString("C0")</strong>
        </article>

        <article class="metric-card">
            <div class="metric-card__top">
                <span class="metric-icon metric-icon--coral">
                    <svg class="i"><use href="#i-transactions" /></svg>
                </span>
                <span class="trend">This month</span>
            </div>
            <p>Average per day</p>
            <strong class="num">@dailyAvg.ToString("C0")</strong>
        </article>

        <article class="metric-card metric-card--accent">
            <div class="metric-card__top">
                <span class="metric-icon metric-icon--ink">
                    <svg class="i"><use href="#i-budget" /></svg>
                </span>
                <span class="metric-kicker">@Model.MonthExpenses.Count @(Model.MonthExpenses.Count == 1 ? "expense" : "expenses")</span>
            </div>
            <p>Spent last month</p>
            <strong class="num">@prevFull.ToString("C0")</strong>
        </article>
    </div>

    <section class="panel cashflow">
        <div class="panel__header">
            <h2>Your Spendings</h2>
            <div class="segmented" aria-label="Chart period">
                <button type="button" class="segmented__active" data-cashflow-tab="month">Monthly</button>
                <button type="button" data-cashflow-tab="week">Weekly</button>
            </div>
        </div>

        <div class="chart-summary">
            <div>
                <span class="legend-dot legend-dot--income"></span>
                @first.ToString("MMMM yyyy") <strong class="num">@spent.ToString("C0")</strong>
            </div>
            <div>
                <span class="legend-dot legend-dot--spend"></span>
                Daily avg <strong class="num">@dailyAvg.ToString("C0")</strong>
            </div>
        </div>

        <div class="chart" id="spendy-chart-month" aria-label="Daily spending histogram for this month">
            <div class="hist-stage" style="--cols: @daysThis">
                @foreach (var b in dailyBars)
                {
                    var hPct = b.Amount > 0 ? Math.Clamp((double)(b.Amount / maxDaily) * 100.0, 4.0, 100.0) : 0.0;
                    var isToday = b.Date == today;
                    <button type="button" class="hist-col"
                            data-hist-title="@b.Date.ToString("d MMMM yyyy") · @b.Amount.ToString("C0")"
                            data-from="@b.Day" data-to="@b.Day"
                            title="@b.Date.ToString("d MMM"): @b.Amount.ToString("C0")">
                        <div class="hist-track">
                            <div class="hist-bar @(isToday ? "hist-bar--today" : b.Amount > 0 ? "hist-bar--active" : "")" style="height: @F(hPct)%"></div>
                        </div>
                        <span class="hist-lbl">@b.Day</span>
                    </button>
                }
            </div>
        </div>

        <div class="chart" id="spendy-chart-week" aria-label="Weekly spending histogram for this month" hidden>
            <div class="hist-stage hist-stage--weekly" style="--cols: @weeklyBars.Length">
                @foreach (var w in weeklyBars)
                {
                    var hPct = w.Amount > 0 ? Math.Clamp((double)(w.Amount / maxWeekly) * 100.0, 4.0, 100.0) : 0.0;
                    <button type="button" class="hist-col"
                            data-hist-title="@w.Label (@w.Range) · @w.Amount.ToString("C0")"
                            data-from="@w.StartDay" data-to="@w.EndDay"
                            title="@w.Range: @w.Amount.ToString("C0")">
                        <div class="hist-track">
                            <strong class="hist-val num">@w.Amount.ToString("C0")</strong>
                            <div class="hist-bar @(w.Amount > 0 ? "hist-bar--active" : "")" style="height: @F(hPct)%"></div>
                        </div>
                        <span class="hist-lbl">@w.Label <small class="d-none d-sm-inline">(@w.Range)</small></span>
                    </button>
                }
            </div>
        </div>
    </section>

    <aside class="right-rail">
        <section class="goal-card transactions">
            <div class="goal-card__top">
                <span class="eyebrow eyebrow--light">Latest</span>
                <a asp-action="Expenses" aria-label="See all expenses" title="See all expenses">
                    <svg class="i" style="width:18px;height:18px"><use href="#i-arrow-up-right" /></svg>
                </a>
            </div>
            <h2>Recent expenses</h2>
            <div class="transaction-list">
                @if (Model.Recent.Count == 0)
                {
                    <p class="mb-0 py-3" style="color:rgba(255,255,255,0.75)">No expenses yet.</p>
                }
                else
                {
                    var recentList = Model.Recent.Take(5).ToList();
                    for (var i = 0; i < recentList.Count; i++)
                    {
                        var item = recentList[i];
                        var tone = CatTone(i);
                        <button type="button"
                                class="transaction"
                                title="Edit @item.Title"
                                data-expense
                                data-id="@item.Id"
                                data-title="@item.Title"
                                data-price="@item.Price"
                                data-category="@item.Category"
                                data-date="@item.Date.ToString("yyyy-MM-dd")"
                                data-paymentmode="@((int)item.PaymentMode)"
                                data-description="@item.Description">
                            <span class="transaction__icon transaction__icon--@tone">
                                <svg class="i"><use href="@CatIcon(item.Category)" /></svg>
                            </span>
                            <div class="transaction__details">
                                <p>@item.Title</p>
                                <span>@item.Category · @item.Date.ToString("d MMM")</span>
                            </div>
                            <strong class="num">− @item.Price?.ToString("C0")</strong>
                        </button>
                    }
                }
            </div>
            <a asp-action="Expenses" class="goal-button text-decoration-none">
                <span>See all expenses</span>
                <svg class="i" style="width:17px;height:17px"><use href="#i-arrow-up-right" /></svg>
            </a>
        </section>

        <section class="panel recurring">
            <div class="panel__header">
                <h2>Biggest this month</h2>
            </div>
            @if (biggestExpenses.Count > 0)
            {
                for (var i = 0; i < biggestExpenses.Count; i++)
                {
                    var bill = biggestExpenses[i];
                    <div class="recurring-item">
                        <span class="recurring-item__date">
                            <strong>@bill.Date.ToString("dd")</strong>
                            @bill.Date.ToString("MMM").ToUpperInvariant()
                        </span>
                        <span class="recurring-item__icon @(i % 2 == 1 ? "recurring-item__icon--coral" : "")">
                            <svg class="i" style="width:18px;height:18px"><use href="@CatIcon(bill.Category)" /></svg>
                        </span>
                        <div class="min-w-0">
                            <p class="text-truncate">@bill.Title</p>
                        </div>
                        <strong class="num">@bill.Price?.ToString("C0")</strong>
                    </div>
                }
            }
            else
            {
                <p class="muted mb-0 mt-3">No expenses this month yet.</p>
            }
        </section>
    </aside>
</section>

<dialog id="hist-dialog" class="sheet" aria-labelledby="hist-dialog-title">
    <div class="modal__header">
        <h2 id="hist-dialog-title">Spendings</h2>
        <button type="button" class="button button--icon" aria-label="Close" onclick="this.closest('dialog').close()">
            <svg class="i"><use href="#i-close" /></svg>
        </button>
    </div>
    <div class="transaction-list" style="max-height:22rem;overflow-y:auto">
        @for (var i = 0; i < monthByPriceDesc.Count; i++)
        {
            var e = monthByPriceDesc[i];
            <button type="button"
                    class="transaction"
                    data-hist-row="@e.Date.Day"
                    data-expense
                    data-id="@e.Id"
                    data-title="@e.Title"
                    data-price="@e.Price"
                    data-category="@e.Category"
                    data-date="@e.Date.ToString("yyyy-MM-dd")"
                    data-paymentmode="@((int)e.PaymentMode)"
                    data-description="@e.Description">
                <span class="transaction__icon transaction__icon--@CatTone(i)">
                    <svg class="i"><use href="@CatIcon(e.Category)" /></svg>
                </span>
                <div class="transaction__details">
                    <p>@e.Title</p>
                    <span>@e.Category · @e.Date.ToString("d MMM") · @e.PaymentMode.DisplayName()</span>
                </div>
                <strong class="num">− @e.Price?.ToString("C0")</strong>
            </button>
        }
        <p id="hist-empty" class="muted mb-0 py-3" hidden>No expenses recorded for this period.</p>
    </div>
</dialog>

<partial name="_ExpenseDialog" model="newExpense" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
