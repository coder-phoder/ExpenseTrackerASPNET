@model ExpensesViewModel
@{
    ViewData["Title"] = "Calendar";
    var month = Model.Month;
    var today = DateOnly.FromDateTime(DateTime.Today);
    var totals = Model.Expenses.GroupBy(e => e.Date).ToDictionary(g => g.Key, g => g.Sum(e => e.Price ?? 0));
}

<div class="page-head">
    <div>
        <h1>@month.ToString("MMMM yyyy")</h1>
        <p>@totals.Values.Sum().ToString("C") spent this month</p>
    </div>
    <div class="page-actions">
        <a asp-action="Calendar" asp-route-month="@month.AddMonths(-1).ToString("yyyy-MM")" class="btn btn-outline-secondary" aria-label="Previous month">&lsaquo;</a>
        <a asp-action="Calendar" class="btn btn-outline-secondary">Today</a>
        <a asp-action="Calendar" asp-route-month="@month.AddMonths(1).ToString("yyyy-MM")" class="btn btn-outline-secondary" aria-label="Next month">&rsaquo;</a>
        <a asp-action="Statement" asp-route-month="@month.ToString("yyyy-MM")" class="btn btn-primary"><svg class="i"><use href="#i-download" /></svg>Print PDF</a>
    </div>
</div>

<section class="card-x cal-card">
    <div class="cal-grid">
        @foreach (var name in new[] { "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun", "Total" })
        {
            <div class="cal-dow @(name is "Sat" or "Sun" ? "weekend" : name == "Total" ? "total" : null)">@name</div>
        }
        @for (var week = month.AddDays(-(((int)month.DayOfWeek + 6) % 7)); week < month.AddMonths(1); week = week.AddDays(7))
        {
            decimal weekTotal = 0;
            for (var day = week; day < week.AddDays(7); day = day.AddDays(1))
            {
                if (day.Month != month.Month)
                {
                    <div></div>
                    continue;
                }
                var date = day.ToString("yyyy-MM-dd");
                var hasTotal = totals.TryGetValue(day, out var total);
                weekTotal += total;
                <a asp-action="Expenses" asp-route-date="@date" class="cal-day @(day == today ? "today" : null)" title="@day.ToString("dd MMM yyyy")"
                   data-date="@date" data-bs-toggle="modal" data-bs-target="#dayModal">
                    @day.Day
                    @if (hasTotal)
                    {
                        <span>@total.ToString("C0")</span>
                    }
                </a>
            }
            <div class="cal-day total">@weekTotal.ToString("C0")</div>
        }
    </div>
</section>

<div class="modal fade" id="dayModal" tabindex="-1" aria-labelledby="dayModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dayModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var e in Model.Expenses)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center" data-date="@e.Date.ToString("yyyy-MM-dd")">
                        <div>
                            @e.Title <small class="text-muted">@e.Category · @e.PaymentMode.DisplayName()</small>
                            <div class="small text-muted">@e.Description</div>
                        </div>
                        <div class="text-nowrap">
                            @e.Price?.ToString("C")
                            <button type="button" class="btn btn-sm btn-outline-primary ms-2" data-bs-toggle="modal" data-bs-target="#expenseModal"
                                    data-id="@e.Id" data-title="@e.Title" data-price="@e.Price" data-date="@e.Date.ToString("yyyy-MM-dd")"
                                    data-paymentmode="@((int)e.PaymentMode)" data-category="@e.Category" data-description="@e.Description">Edit</button>
                        </div>
                    </li>
                }
                <li class="list-group-item text-muted" id="noExpenses">No expenses.</li>
            </ul>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="addExpense" data-bs-toggle="modal" data-bs-target="#expenseModal"
                        data-id="0" data-paymentmode="0">Add expense</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="expenseModal" tabindex="-1" aria-labelledby="expenseModalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <form class="modal-content" id="expenseForm" asp-action="Expenses" method="post">
            <div class="modal-header">
                <h5 class="modal-title" id="expenseModalTitle"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <partial name="_ExpenseFields" />
                <input type="hidden" name="returnUrl" />
            </div>
            <div class="modal-footer">
                <button type="submit" class="btn btn-outline-danger me-auto" id="deleteExpense" form="deleteForm"
                        onclick="return confirm('Delete this expense?')">Delete</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>

<form id="deleteForm" asp-action="DeleteExpense" method="post">
    <input type="hidden" name="id" />
    <input type="hidden" name="returnUrl" />
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const dayModal = document.getElementById('dayModal');
        dayModal.addEventListener('show.bs.modal', e => {
            const date = e.relatedTarget.dataset.date;
            const rows = [...dayModal.querySelectorAll('li[data-date]')];
            rows.forEach(li => li.classList.toggle('d-none', li.dataset.date !== date));
            document.getElementById('noExpenses').hidden = rows.some(li => li.dataset.date === date);
            dayModal.querySelector('.modal-title').textContent = e.relatedTarget.title;
            document.getElementById('addExpense').dataset.date = date;
        });

        const expenseModal = document.getElementById('expenseModal');
        const form = document.getElementById('expenseForm');
        const deleteForm = document.getElementById('deleteForm');
        expenseModal.addEventListener('show.bs.modal', e => {
            const d = e.relatedTarget.dataset;
            form.reset();
            for (const name of ['Id', 'Title', 'Price', 'Category', 'Date', 'PaymentMode', 'Description']) {
                form.elements['Expense.' + name].value = d[name.toLowerCase()] ?? '';
            }
            form.elements.returnUrl.value = deleteForm.elements.returnUrl.value = location.pathname + '?day=' + d.date;
            deleteForm.elements.id.value = d.id;
            document.getElementById('deleteExpense').hidden = d.id === '0';
            expenseModal.querySelector('.modal-title').textContent = d.id === '0' ? 'Add expense' : 'Edit expense';
        });

        const reopen = new URLSearchParams(location.search).get('day');
        if (reopen) document.querySelector(`a[data-date="${reopen}"]`)?.click();
    </script>
}
