@using System.Globalization
@model List<Expense>
@{
    ViewData["Title"] = "Analytics";
}

@if (Model.Count == 0)
{
    <section class="panel text-center py-5">
        <h2 class="mb-4" style="font-family:var(--font-display);font-size:2rem;font-weight:400">No expenses yet</h2>
        <a asp-action="Expenses" class="button button--primary">Add expense</a>
    </section>
    return;
}

@{
    var today = DateOnly.FromDateTime(DateTime.Today);
    var thisMonth = new DateOnly(today.Year, today.Month, 1);
    var lastMonth = thisMonth.AddMonths(-1);
    string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    decimal Spent(Func<Expense, bool> match) => Model.Where(match).Sum(e => e.Price ?? 0m);
    decimal InMonth(DateOnly m) => Spent(e => e.Date.Year == m.Year && e.Date.Month == m.Month);

    string CompactMoney(decimal v) => v >= 100000m
        ? $"₹{(v / 100000m).ToString("0.#", CultureInfo.InvariantCulture)}L"
        : v >= 1000m
            ? $"₹{(v / 1000m).ToString("0.#", CultureInfo.InvariantCulture)}k"
            : v.ToString("C0");

    string CatIcon(string? cat) => (cat?.Trim().ToLowerInvariant()) switch
    {
        "food" or "dining" or "groceries" => "#i-coffee",
        "travel" or "transport" or "commute" => "#i-car",
        "bills" or "utilities" or "electricity" => "#i-repeat",
        "home" or "rent" => "#i-home",
        "shopping" or "entertainment" => "#i-shopping",
        _ => "#i-briefcase"
    };

    var total = Math.Max(1m, Spent(_ => true));
    var monthTotal = InMonth(thisMonth);
    var prevMonthTotal = InMonth(lastMonth);
    var dailyAvg = today.Day > 0 ? Math.Round(monthTotal / today.Day) : 0m;
    var avgTicket = Math.Round(total / Model.Count);

    // Mindful Split: Needs (Essentials) vs Wants (Lifestyle) vs Buffer/Other
    bool IsNeed(string c) => c.Equals("Bills", StringComparison.OrdinalIgnoreCase)
        || c.Equals("Food", StringComparison.OrdinalIgnoreCase)
        || c.Equals("Home", StringComparison.OrdinalIgnoreCase)
        || c.Equals("Health", StringComparison.OrdinalIgnoreCase)
        || c.Equals("Groceries", StringComparison.OrdinalIgnoreCase);

    bool IsWant(string c) => c.Equals("Shopping", StringComparison.OrdinalIgnoreCase)
        || c.Equals("Entertainment", StringComparison.OrdinalIgnoreCase)
        || c.Equals("Travel", StringComparison.OrdinalIgnoreCase)
        || c.Equals("Dining", StringComparison.OrdinalIgnoreCase);

    var needsAmt = Spent(e => IsNeed(e.Category));
    var wantsAmt = Spent(e => IsWant(e.Category));
    var otherAmt = Math.Max(0m, total - needsAmt - wantsAmt);

    var needsPct = (int)Math.Round(needsAmt / total * 100m);
    var wantsPct = (int)Math.Round(wantsAmt / total * 100m);
    var otherPct = Math.Max(0, 100 - needsPct - wantsPct);

    // Zero-spend calm days in the current month
    var activeDaysThisMonth = Model
        .Where(e => e.Date >= thisMonth && e.Date <= today && (e.Price ?? 0m) > 0m)
        .Select(e => e.Date)
        .Distinct()
        .Count();
    var calmDaysThisMonth = Math.Max(0, today.Day - activeDaysThisMonth);

    // 12-Month Horizon data
    var months = Enumerable.Range(-11, 12)
        .Select(i => thisMonth.AddMonths(i))
        .Select(m => (Month: m, Tick: m.ToString("MMM"), FullName: m.ToString("MMMM yyyy"), Amount: InMonth(m)))
        .ToArray();
    var maxMonthAmt = Math.Max(1m, months.Max(m => m.Amount));
    var activeMonths = months.Where(m => m.Amount > 0m).ToArray();
    var avgMonthlyAmt = activeMonths.Length > 0 ? activeMonths.Average(m => m.Amount) : 0m;
    var avgLineBottomPct = Math.Clamp((double)(avgMonthlyAmt / maxMonthAmt) * 100.0, 12.0, 88.0);
    var peakMonthAmt = months.Max(m => m.Amount);

    // Categories breakdown + Donut slices
    (string Color, string Tone, string BarClass)[] catStyles =
    [
        ("var(--coral)", "coral", "budget-bar__fill--coral"),
        ("var(--mint)", "mint", "budget-bar__fill--ink"),
        ("var(--blue)", "blue", "budget-bar__fill--blue"),
        ("var(--sand)", "sand", "budget-bar__fill--coral"),
        ("var(--ink)", "mint", "budget-bar__fill--ink")
    ];

    var categories = Model
        .GroupBy(e => e.Category)
        .Select(g => (Name: g.Key, Amount: g.Sum(e => e.Price ?? 0m), Count: g.Count()))
        .OrderByDescending(c => c.Amount)
        .ToList();

    var topCategories = categories.Take(5).ToList();
    var topCatName = topCategories.FirstOrDefault().Name ?? "Living";

    string[] monthTones = ["ink", "coral", "blue"];
    var monthCategories = Model
        .Where(e => e.Date >= thisMonth && e.Date < thisMonth.AddMonths(1))
        .GroupBy(e => e.Category)
        .Select(g => (Label: g.Key, Spent: g.Sum(e => e.Price ?? 0m)))
        .OrderByDescending(c => c.Spent)
        .ToList();
    var topMonthCategories = monthCategories.Take(3)
        .Select((c, i) => (c.Label, c.Spent, Percent: monthTotal > 0 ? Math.Clamp((int)Math.Round(c.Spent / monthTotal * 100m), 6, 100) : 0, Tone: monthTones[i]))
        .ToList();

    // Day-of-week habit capsules (Mon..Sun)
    DayOfWeek[] dowOrder = [DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday];
    string[] dowShort = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    string[] dowFull = ["Mondays", "Tuesdays", "Wednesdays", "Thursdays", "Fridays", "Saturdays", "Sundays"];
    var dowAmounts = dowOrder
        .Select(d => Spent(e => e.Date.DayOfWeek == d))
        .ToArray();
    var maxDowAmt = Math.Max(1m, dowAmounts.Max());
    var peakDowIndex = Array.IndexOf(dowAmounts, dowAmounts.Max());
    var weekendSharePct = (int)Math.Round((dowAmounts[5] + dowAmounts[6]) / total * 100m);

    // Last 14 days daily habit strip
    var last14Days = Enumerable.Range(-13, 14)
        .Select(offset => today.AddDays(offset))
        .Select(d => (Date: d, Amount: Spent(e => e.Date == d)))
        .ToArray();

    // Payment modes
    (string Name, PaymentMode Mode, decimal Amount, string Color)[] modes = Enum.GetValues<PaymentMode>()
        .Select((p, idx) => (
            Name: p.DisplayName(),
            Mode: p,
            Amount: Spent(e => e.PaymentMode == p),
            Color: catStyles[idx % catStyles.Length].Color
        ))
        .Where(m => m.Amount > 0m)
        .OrderByDescending(m => m.Amount)
        .ToArray();

    var allCatNames = categories.Select(c => c.Name).Order().ToList();
    var dialogModel = new ExpensesViewModel([], new Expense { Date = today }, allCatNames);
}

<div class="an-grid">
    @* 1. Summary Banner *@
    <section class="an-hero an-col-12">
        <div class="an-hero__main">
            <div>
                <h2 class="an-hero__headline">
                    @if (monthTotal <= prevMonthTotal && prevMonthTotal > 0)
                    {
                        <text>You spent <em>@((prevMonthTotal - monthTotal).ToString("C0")) less</em> than last month.</text>
                    }
                    else
                    {
                        <text>You spent the most on <em>@topCatName</em>.</text>
                    }
                </h2>
            </div>

            <div class="an-split-box">
                <div class="an-split-bar" role="img" aria-label="Basic needs @needsPct%, Personal & fun @wantsPct%, Other @otherPct%">
                    <span style="flex: @Math.Max(8, needsPct); background: var(--mint)"></span>
                    <span style="flex: @Math.Max(8, wantsPct); background: var(--coral)"></span>
                    <span style="flex: @Math.Max(6, otherPct); background: var(--sand)"></span>
                </div>
                <div class="an-split-legend">
                    <div class="an-split-item">
                        <span class="an-split-dot" style="background: var(--mint)"></span>
                        <span>Basic needs <strong class="num">@needsPct%</strong></span>
                    </div>
                    <div class="an-split-item">
                        <span class="an-split-dot" style="background: var(--coral)"></span>
                        <span>Personal &amp; fun <strong class="num">@wantsPct%</strong></span>
                    </div>
                    <div class="an-split-item">
                        <span class="an-split-dot" style="background: var(--sand)"></span>
                        <span>Other <strong class="num">@otherPct%</strong></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="an-hero__stats">
            <div class="an-glass-stat">
                <span>This month</span>
                <strong class="num">@CompactMoney(monthTotal)</strong>
            </div>
            <div class="an-glass-stat">
                <span>No-spend days</span>
                <strong class="num">@calmDaysThisMonth</strong>
            </div>
            <div class="an-glass-stat">
                <span>Average expense</span>
                <strong class="num">@avgTicket.ToString("C0")</strong>
            </div>
            <div class="an-glass-stat">
                <span>Total spent</span>
                <strong class="num">@CompactMoney(total)</strong>
            </div>
        </div>

        <div class="an-hero__orbit an-hero__orbit--one"></div>
        <div class="an-hero__orbit an-hero__orbit--two"></div>
    </section>

    @* 2. 12-Month Spending Chart *@
    <section class="panel an-col-7">
        <div class="panel__header">
            <h2>Monthly spending (last 12 months)</h2>
            <span class="an-horizon__avg num">
                Monthly avg: @CompactMoney(avgMonthlyAmt)
            </span>
        </div>

        <div class="chart-summary" style="margin-top:0.9rem">
            <div><span class="legend-dot" style="background:var(--mint)"></span>Low</div>
            <div><span class="legend-dot" style="background:var(--ink)"></span>This month</div>
            <div><span class="legend-dot" style="background:var(--coral)"></span>Highest</div>
        </div>

        <div class="an-horizon">
            <div class="an-horizon__stage">
                @if (avgMonthlyAmt > 0)
                {
                    <div class="an-horizon__avg-line" style="bottom: @F(avgLineBottomPct)%"></div>
                }
                @foreach (var m in months)
                {
                    var hPct = m.Amount > 0 ? Math.Clamp((double)(m.Amount / maxMonthAmt) * 100.0, 8.0, 100.0) : 4.0;
                    var isCurrent = m.Month == thisMonth;
                    var isPeak = m.Amount == peakMonthAmt && m.Amount > 0;
                    var isCalm = m.Amount > 0 && m.Amount <= avgMonthlyAmt * 0.85m && !isCurrent;
                    var barMod = isPeak ? "an-month-bar--peak" : isCurrent ? "an-month-bar--current" : isCalm ? "an-month-bar--calm" : "";
                    <div class="an-month-col" tabindex="0" style="--bar-h: @F(hPct)%" aria-label="@m.FullName: @m.Amount.ToString("C0")">
                        <div class="an-month-tip">
                            <strong class="num">@m.Amount.ToString("C0")</strong>
                            <span>@m.FullName</span>
                        </div>
                        <div class="an-month-bar @barMod" style="height: @F(hPct)%"></div>
                    </div>
                }
            </div>
            <div class="an-horizon__labels">
                @foreach (var m in months)
                {
                    <span>@m.Tick</span>
                }
            </div>
        </div>
    </section>

    @* 3. Spending by Category *@
    <section class="panel an-col-5">
        <div class="panel__header">
            <h2>Spending by category</h2>
        </div>

        <div class="an-donut-wrap">
            <div class="an-donut">
                @{
                    const double ringCirc = 314.16; // 2 * pi * 50
                    var ringOffset = 0.0;
                }
                <svg viewBox="0 0 120 120" role="img" aria-label="Spending by category chart">
                    <circle cx="60" cy="60" r="50" fill="none" stroke="var(--line-soft)" stroke-width="14" />
                    @for (var i = 0; i < topCategories.Count; i++)
                    {
                        var cat = topCategories[i];
                        var style = catStyles[i % catStyles.Length];
                        var seg = Math.Max(0.0, (double)(cat.Amount / total) * ringCirc);
                        <circle cx="60"
                                cy="60"
                                r="50"
                                fill="none"
                                stroke="@style.Color"
                                stroke-width="14"
                                stroke-dasharray="@F(seg) @F(ringCirc)"
                                stroke-dashoffset="@F(-ringOffset)" />
                        ringOffset += seg;
                    }
                </svg>
                <div class="an-donut__center">
                    <strong class="num">@CompactMoney(total)</strong>
                </div>
            </div>

            <div class="an-cat-list">
                @for (var i = 0; i < topCategories.Count; i++)
                {
                    var cat = topCategories[i];
                    var style = catStyles[i % catStyles.Length];
                    var pct = (int)Math.Round(cat.Amount / total * 100m);
                    var relWidth = Math.Clamp((int)Math.Round(cat.Amount / topCategories[0].Amount * 100m), 8, 100);
                    <div class="an-cat-item">
                        <span class="transaction__icon transaction__icon--@style.Tone" style="width:2.2rem;height:2.2rem;border-radius:0.65rem">
                            <svg class="i" style="width:16px;height:16px"><use href="@CatIcon(cat.Name)" /></svg>
                        </span>
                        <div class="an-cat-body">
                            <div class="an-cat-head">
                                <strong>@cat.Name</strong>
                                <span class="num">@CompactMoney(cat.Amount)</span>
                            </div>
                            <div class="budget-bar" style="margin-top:0">
                                <span class="budget-bar__fill @style.BarClass" style="width: @(relWidth)%"></span>
                            </div>
                        </div>
                        <span class="an-cat-pct num">@pct%</span>
                    </div>
                }
            </div>
        </div>
    </section>

    <section class="panel spending an-col-12">
        <div class="panel__header">
            <h2>Top categories this month</h2>
            <span class="days-left">@monthCategories.Count @(monthCategories.Count == 1 ? "category" : "categories")</span>
        </div>
        @if (topMonthCategories.Count == 0)
        {
            <p class="muted mb-0 mt-3">No expenses added this month yet.</p>
        }
        else
        {
            <div class="budget-list">
                @foreach (var row in topMonthCategories)
                {
                    <div class="budget-row">
                        <div class="budget-row__heading">
                            <p>@row.Label</p>
                            <span class="num"><strong>@row.Spent.ToString("C0")</strong> (@row.Percent%)</span>
                        </div>
                        <div class="budget-bar">
                            <span class="budget-bar__fill budget-bar__fill--@row.Tone" style="width: @(row.Percent)%"></span>
                        </div>
                    </div>
                }
            </div>
        }
        <a asp-action="Calendar" class="text-link">
            Open calendar
            <svg class="i" style="width:15px;height:15px"><use href="#i-arrow-up-right" /></svg>
        </a>
    </section>

    @* 4. Spending by Day of the Week *@
    <section class="panel an-col-6">
        <div class="panel__header">
            <h2>Spending by day of week</h2>
            <span class="days-left num">@weekendSharePct% on weekends</span>
        </div>

        <div class="an-week-capsules">
            @for (var i = 0; i < 7; i++)
            {
                var amt = dowAmounts[i];
                var fillPct = Math.Clamp((int)Math.Round(amt / maxDowAmt * 100m), 10, 100);
                var isPeak = i == peakDowIndex;
                <div class="an-day-pill @(isPeak ? "an-day-pill--peak" : "")" title="@dowFull[i]: @amt.ToString("C0")">
                    <span class="an-day-pill__name">@dowShort[i]</span>
                    <div class="an-day-pill__track">
                        <div class="an-day-pill__fill" style="height: @(fillPct)%"></div>
                    </div>
                    <span class="an-day-pill__amt num">@CompactMoney(amt)</span>
                </div>
            }
        </div>

        <div class="an-habit-strip">
            <p class="muted small mb-2">Last 14 days (green = ₹0 spent, red = high spending)</p>
            <div class="an-habit-dots">
                @foreach (var d in last14Days)
                {
                    var toneClass = d.Amount <= 0m
                        ? "an-dot--zero"
                        : d.Amount <= dailyAvg * 0.8m
                            ? "an-dot--low"
                            : d.Amount <= dailyAvg * 1.6m
                                ? "an-dot--mid"
                                : "an-dot--high";
                    <div class="an-dot @toneClass" title="@d.Date.ToString("ddd, MMM d"): @d.Amount.ToString("C0")">
                        @d.Date.Day
                    </div>
                }
            </div>
        </div>
    </section>

    @* 5. Payment Methods & Biggest Expenses *@
    <section class="panel an-col-6">
        <div class="panel__header">
            <h2>How you paid &amp; biggest expenses</h2>
            <a asp-action="Expenses" asp-route-sort="price_desc" class="text-link">
                See all
                <svg class="i" style="width:15px;height:15px"><use href="#i-arrow-up-right" /></svg>
            </a>
        </div>

        <div class="an-split-bar" style="margin:1rem 0 0.75rem;background:var(--line-soft)">
            @foreach (var m in modes)
            {
                var share = Math.Max(6, (int)Math.Round(m.Amount / total * 100m));
                <span style="flex: @share; background: @m.Color" title="@m.Name: @m.Amount.ToString("C0")"></span>
            }
        </div>

        <div class="an-mode-cards">
            @foreach (var m in modes)
            {
                var pct = (int)Math.Round(m.Amount / total * 100m);
                <div class="an-mode-card">
                    <div class="an-mode-card__top">
                        <span>@m.Name</span>
                        <span class="num" style="color:var(--coral)">@pct%</span>
                    </div>
                    <strong class="num">@CompactMoney(m.Amount)</strong>
                </div>
            }
        </div>

        <div class="mt-3 pt-1">
            <div class="transaction-list" style="margin-top:0">
                @{
                    var topSpends = Model.OrderByDescending(e => e.Price).Take(4).ToList();
                }
                @for (var i = 0; i < topSpends.Count; i++)
                {
                    var e = topSpends[i];
                    <button type="button"
                            class="transaction"
                            data-expense
                            data-id="@e.Id"
                            data-title="@e.Title"
                            data-price="@e.Price"
                            data-category="@e.Category"
                            data-date="@e.Date.ToString("yyyy-MM-dd")"
                            data-paymentmode="@((int)e.PaymentMode)"
                            data-description="@e.Description">
                        <span class="an-rank-badge">0@(i + 1)</span>
                        <div class="transaction__details">
                            <p>@e.Title</p>
                            <span>@e.Category</span>
                        </div>
                        <strong class="num">@e.Price?.ToString("C0")</strong>
                    </button>
                }
            </div>
        </div>
    </section>
</div>

<partial name="_ExpenseDialog" model="dialogModel" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
