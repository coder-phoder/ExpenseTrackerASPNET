@model ExpensesViewModel
@{
    ViewData["Title"] = "Expenses";
    var editing = Model.Expense.Id != 0;
    var filter = Context.Request.Query;
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-4">
        <h4>@(editing ? "Edit expense" : "Add expense")</h4>
        <form asp-action="Expenses" method="post">
            <partial name="_ExpenseFields" for="Expense" />
            <button type="submit" class="btn btn-primary">@(editing ? "Save" : "Add")</button>
            @if (editing)
            {
                <a asp-action="Expenses" class="btn btn-link">Cancel</a>
            }
        </form>
    </div>
    <div class="col-md-8">
        <form asp-action="Expenses" method="get" class="row g-2 mb-3">
            <div class="col-12 col-lg-4">
                <input type="search" name="q" value="@filter["q"]" class="form-control" placeholder="Search title" aria-label="Search title" />
            </div>
            <div class="col-6 col-lg">
                <input type="date" name="from" value="@filter["from"]" class="form-control" aria-label="From date" title="From date" />
            </div>
            <div class="col-6 col-lg">
                <input type="date" name="to" value="@filter["to"]" class="form-control" aria-label="To date" title="To date" />
            </div>
            <div class="col-6 col-lg">
                <select name="mode" class="form-select" aria-label="Payment mode">
                    <option value="">All modes</option>
                    @foreach (var m in Enum.GetValues<PaymentMode>())
                    {
                        <option value="@m" selected="@(filter["mode"] == m.ToString())">@m.DisplayName()</option>
                    }
                </select>
            </div>
            <div class="col-6 col-lg">
                <select name="sort" class="form-select" aria-label="Sort by">
                    <option value="">Newest first</option>
                    <option value="date_asc" selected="@(filter["sort"] == "date_asc")">Oldest first</option>
                    <option value="price_desc" selected="@(filter["sort"] == "price_desc")">Price: high to low</option>
                    <option value="price_asc" selected="@(filter["sort"] == "price_asc")">Price: low to high</option>
                </select>
            </div>
            <div class="col-12 col-lg-auto">
                <button type="submit" class="btn btn-outline-primary">Apply</button>
                <a asp-action="Expenses" class="btn btn-link">Clear</a>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Mode</th>
                        <th class="text-end">Price</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Expenses)
                    {
                        <tr>
                            <td>@e.Date.ToString("dd MMM yyyy")</td>
                            <td>@e.Title</td>
                            <td>@e.Description</td>
                            <td>@e.PaymentMode.DisplayName()</td>
                            <td class="text-end">@e.Price?.ToString("C")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Expenses" asp-route-edit="@e.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="DeleteExpense" asp-route-id="@e.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this expense?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.Expenses.Count == 0)
                    {
                        <tr><td colspan="6" class="text-muted">No expenses found.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
