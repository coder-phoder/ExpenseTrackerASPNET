@using ExpenseTracker.Controllers
@model ExpensesViewModel
@{
    ViewData["Title"] = "Expenses";
    var filter = Context.Request.Query;
    var activeFilters = new[] { "from", "to", "mode", "category" }.Count(k => !string.IsNullOrEmpty(filter[k]));
    var filtered = activeFilters > 0 || !string.IsNullOrEmpty(filter["q"]);
    var here = $"{Context.Request.Path}{Context.Request.QueryString}";
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    var firstRow = (Model.Page - 1) * UserController.PageSize + 1;
}

<div class="page-head">
    <div>
        <h1>Expenses</h1>
        @if (Model.Count > 0)
        {
            <p>@Model.Total.ToString("C") across @Model.Count.ToString("N0") @(Model.Count == 1 ? "expense" : "expenses")@(filtered ? " matching your filters" : "")</p>
        }
    </div>
    <div class="page-actions">
        <a href="@Url.Action("ExportCsv")@Context.Request.QueryString" class="btn btn-outline-secondary"><svg class="i"><use href="#i-download" /></svg>Export CSV</a>
        <button type="button" class="btn btn-primary" data-expense data-id="0" data-date="@today" data-paymentmode="0"><svg class="i"><use href="#i-plus" /></svg>New expense</button>
    </div>
</div>

@* Sort applies straight away; search applies with Enter, and the filters in the panel with Apply. *@
<form asp-action="Expenses" method="get" id="filters" class="toolbar" onchange="if (event.target.name == 'sort') this.requestSubmit()">
    <div class="search">
        <svg class="i" aria-hidden="true"><use href="#i-search" /></svg>
        <input type="search" name="q" value="@filter["q"]" class="form-control" placeholder="Search by title" aria-label="Search by title" />
    </div>
    <div class="dropdown">
        <button type="button" class="btn btn-outline-secondary" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
            <svg class="i"><use href="#i-filter" /></svg>Filters
            @if (activeFilters > 0)
            {
                <span class="badge-x">@activeFilters</span>
            }
        </button>
        <div class="dropdown-menu dropdown-menu-end filter-panel">
            <label class="form-label" for="f-from">Date</label>
            <div class="range">
                <input type="date" name="from" id="f-from" value="@filter["from"]" class="form-control" aria-label="From date" />
                <span>to</span>
                <input type="date" name="to" value="@filter["to"]" class="form-control" aria-label="To date" />
            </div>
            <label class="form-label" for="f-mode">Payment mode</label>
            <select name="mode" id="f-mode" class="form-select">
                <option value="">All payment modes</option>
                @foreach (var m in Enum.GetValues<PaymentMode>())
                {
                    <option value="@m" selected="@(filter["mode"] == m.ToString())">@m.DisplayName()</option>
                }
            </select>
            <label class="form-label" for="f-category">Category</label>
            <select name="category" id="f-category" class="form-select">
                <option value="">All categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option selected="@(filter["category"] == c)">@c</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Apply</button>
        </div>
    </div>
    <select name="sort" class="form-select" aria-label="Sort by">
        <option value="">Newest first</option>
        <option value="date_asc" selected="@(filter["sort"] == "date_asc")">Oldest first</option>
        <option value="price_desc" selected="@(filter["sort"] == "price_desc")">Highest amount</option>
        <option value="price_asc" selected="@(filter["sort"] == "price_asc")">Lowest amount</option>
    </select>
    @if (filtered || !string.IsNullOrEmpty(filter["sort"]))
    {
        <a asp-action="Expenses" class="btn btn-link">Clear</a>
    }
</form>

<section class="card-x card-flush">
    @if (Model.Expenses.Count == 0)
    {
        <div class="empty-block">
            @if (filtered)
            {
                <p>No expenses match these filters.</p>
                <a asp-action="Expenses" class="btn btn-outline-secondary btn-sm">Clear filters</a>
            }
            else
            {
                <p>No expenses yet. Add one and it appears here.</p>
                <button type="button" class="btn btn-primary btn-sm" data-expense data-id="0" data-date="@today" data-paymentmode="0">New expense</button>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-x">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Expense</th>
                        <th class="d-none d-md-table-cell">Category</th>
                        <th class="d-none d-lg-table-cell">Payment</th>
                        <th class="text-end">Amount</th>
                        <th><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Expenses)
                    {
                        <tr>
                            <td class="text-nowrap muted">@e.Date.ToString("d MMM yyyy")</td>
                            <td>
                                <div class="cell-title">@e.Title</div>
                                <div class="cell-sub d-md-none">@e.Category</div>
                                @if (!string.IsNullOrEmpty(e.Description))
                                {
                                    <div class="cell-sub">@e.Description</div>
                                }
                            </td>
                            <td class="d-none d-md-table-cell"><span class="badge-x">@e.Category</span></td>
                            <td class="d-none d-lg-table-cell muted text-nowrap">@e.PaymentMode.DisplayName()</td>
                            <td class="text-end num text-nowrap fw-medium">@e.Price?.ToString("C")</td>
                            <td class="row-actions">
                                <button type="button" class="icon-btn" title="Edit" aria-label="Edit @e.Title" data-expense
                                        data-id="@e.Id" data-title="@e.Title" data-price="@e.Price" data-category="@e.Category" data-date="@e.Date.ToString("yyyy-MM-dd")"
                                        data-paymentmode="@((int)e.PaymentMode)" data-description="@e.Description">
                                    <svg class="i"><use href="#i-edit" /></svg>
                                </button>
                                <form asp-action="DeleteExpense" asp-route-id="@e.Id" method="post" onsubmit="return confirm('Delete this expense?')">
                                    <input type="hidden" name="returnUrl" value="@here" />
                                    <button type="submit" class="icon-btn is-danger" title="Delete" aria-label="Delete @e.Title"><svg class="i"><use href="#i-trash" /></svg></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-foot">
            <span>Showing @firstRow–@(firstRow + Model.Expenses.Count - 1) of @Model.Count.ToString("N0")</span>
            @if (Model.PageCount > 1)
            {
                @* Page buttons submit the filter form, so search, filters and sort carry over. *@
                <nav class="pager" aria-label="Expense pages">
                    <button type="submit" form="filters" name="page" value="@(Model.Page - 1)" class="btn btn-outline-secondary btn-sm" disabled="@(Model.Page == 1)">Previous</button>
                    <span>Page @Model.Page of @Model.PageCount</span>
                    <button type="submit" form="filters" name="page" value="@(Model.Page + 1)" class="btn btn-outline-secondary btn-sm" disabled="@(Model.Page == Model.PageCount)">Next</button>
                </nav>
            }
        </div>
    }
</section>

<partial name="_ExpenseDialog" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* Reopen the form after a rejected save, or when a calendar day without script support linked here with its date. *@
    @if (!ViewData.ModelState.IsValid || filter.ContainsKey("date"))
    {
        <script>document.getElementById('expense-dialog').showModal();</script>
    }
}
