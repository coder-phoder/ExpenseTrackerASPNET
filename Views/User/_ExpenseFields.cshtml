@model ExpensesViewModel

<input type="hidden" asp-for="Expense.Id" />

<label class="field">
    <span>Amount</span>
    <div class="amount-input">
        <span>₹</span>
        <input asp-for="Expense.Price" class="num" inputmode="decimal" placeholder="0.00" />
    </div>
    <span asp-validation-for="Expense.Price" class="text-danger small"></span>
</label>

<label class="field">
    <span>Title</span>
    <input asp-for="Expense.Title" placeholder="e.g. Milk, Groceries, Bus ticket" />
    <span asp-validation-for="Expense.Title" class="text-danger small"></span>
</label>

<div class="form-row">
    <label class="field">
        <span>Category</span>
        <select asp-for="Expense.Category" asp-items="new SelectList(Model.Categories)">
            <option value="">Select category</option>
        </select>
        <span asp-validation-for="Expense.Category" class="text-danger small"></span>
    </label>

    <label class="field">
        <span>How did you pay?</span>
        <select asp-for="Expense.PaymentMode" asp-items="Html.GetEnumSelectList<PaymentMode>()"></select>
    </label>
</div>

<div class="form-row">
    <label class="field">
        <span>Date</span>
        <input asp-for="Expense.Date" />
        <span asp-validation-for="Expense.Date" class="text-danger small"></span>
    </label>

    <label class="field">
        <span>Notes (optional)</span>
        <input asp-for="Expense.Description" placeholder="Extra details" />
        <span asp-validation-for="Expense.Description" class="text-danger small"></span>
    </label>
</div>
