@using ExpenseTracker.Controllers
@model List<UserSummary>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="mb-0">Users</h1>
    <span class="text-body-secondary">@Model.Count registered</span>
</div>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th class="text-end">Expenses</th>
                <th class="text-end">Total spent</th>
                <th>Last expense</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.Name</td>
                    <td>@u.Email</td>
                    <td class="text-end">@u.ExpenseCount</td>
                    <td class="text-end text-nowrap">@u.TotalSpent.ToString("C")</td>
                    <td class="text-nowrap">@(u.LastExpense?.ToString("dd MMM yyyy") ?? "—")</td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="6" class="text-body-secondary">No users yet.</td></tr>
            }
        </tbody>
    </table>
</div>
