@using System.Security.Claims
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isUser = signedIn && !User.IsInRole("Admin");
    var action = ViewContext.RouteData.Values["action"] as string;
    var current = action;
    var name = User.Identity?.Name ?? "Krish Parikh";
    var firstName = name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Krish";
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
    if (string.IsNullOrEmpty(initials)) initials = "KP";

    var hour = DateTime.Now.Hour;
    var greeting = hour < 12 ? "Good morning" : hour < 17 ? "Good afternoon" : "Good evening";
    var todayIso = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    var thisMonthIso = DateTime.Today.ToString("yyyy-MM");

    (string Action, string Label, string Icon)[] navItems = isUser
        ? [
            ("Dashboard", "Overview", "overview"),
            ("Expenses", "Expenses", "transactions"),
            ("Calendar", "Calendar", "budget"),
            ("Analytics", "Analytics", "goals")
        ]
        : [];
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Spendy</title>
    <script type="importmap"></script>
    <partial name="_Theme" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&amp;family=Geist+Mono:wght@400..700&amp;family=Manrope:wght@400;500;600;700&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExpenseTracker.styles.css" asp-append-version="true" />
</head>
<body>
    <svg class="position-absolute" width="0" height="0" aria-hidden="true">
        <symbol id="i-overview" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="2" /><rect x="14" y="3" width="7" height="7" rx="2" /><rect x="3" y="14" width="7" height="7" rx="2" /><rect x="14" y="14" width="7" height="7" rx="2" /></symbol>
        <symbol id="i-transactions" viewBox="0 0 24 24"><path d="M7 7h11l-3-3" /><path d="m18 7-3 3" /><path d="M17 17H6l3 3" /><path d="m6 17 3-3" /></symbol>
        <symbol id="i-budget" viewBox="0 0 24 24"><path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z" /><path d="M8 8h8M8 12h2m4 0h2M8 16h2m4 0h2" /></symbol>
        <symbol id="i-goals" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" /></symbol>
        <symbol id="i-settings" viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21H9.6v-.1A1.7 1.7 0 0 0 8.5 19.4a1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.6-1H3v-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6 1.7 1.7 0 0 0 10 3h4a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9a1.7 1.7 0 0 0 1.6 1h.1v4H21a1.7 1.7 0 0 0-1.6 1Z" /></symbol>
        <symbol id="i-bell" viewBox="0 0 24 24"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" /><path d="M10 21h4" /></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
        <symbol id="i-arrow-up-right" viewBox="0 0 24 24"><path d="M7 17 17 7" /><path d="M7 7h10v10" /></symbol>
        <symbol id="i-arrow-down-left" viewBox="0 0 24 24"><path d="M17 7 7 17" /><path d="M17 17H7V7" /></symbol>
        <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z" /><circle cx="12" cy="12" r="2.5" /></symbol>
        <symbol id="i-eye-off" viewBox="0 0 24 24"><path d="m3 3 18 18" /><path d="M10.6 6.2A9.7 9.7 0 0 1 12 6c6.5 0 10 6 10 6a16 16 0 0 1-2.1 2.8M6.6 6.6C3.5 8.4 2 12 2 12s3.5 6 10 6c1.6 0 3-.4 4.2-1" /></symbol>
        <symbol id="i-chevron-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" /></symbol>
        <symbol id="i-wallet" viewBox="0 0 24 24"><path d="M4 6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v13H6a2 2 0 0 1-2-2Z" /><path d="M16 10h6v5h-6a2.5 2.5 0 0 1 0-5Z" /></symbol>
        <symbol id="i-card" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3" /><path d="M3 10h18M7 15h3" /></symbol>
        <symbol id="i-home" viewBox="0 0 24 24"><path d="m3 11 9-8 9 8" /><path d="M5 10v10h14V10M9 20v-6h6v6" /></symbol>
        <symbol id="i-coffee" viewBox="0 0 24 24"><path d="M4 9h13v5a6 6 0 0 1-6 6H10a6 6 0 0 1-6-6Z" /><path d="M17 11h1a3 3 0 0 1 0 6h-2M8 5v1m4-1v1" /></symbol>
        <symbol id="i-car" viewBox="0 0 24 24"><path d="m5 16-1-1v-4l2-5h12l2 5v4l-1 1" /><path d="M5 16v3h3v-3m8 0v3h3v-3M4 11h16M7 14h.01M17 14h.01" /></symbol>
        <symbol id="i-shopping" viewBox="0 0 24 24"><path d="M5 8h14l-1 13H6Z" /><path d="M9 10V6a3 3 0 0 1 6 0v4" /></symbol>
        <symbol id="i-briefcase" viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M9 7V4h6v3M3 12h18M10 12v2h4v-2" /></symbol>
        <symbol id="i-repeat" viewBox="0 0 24 24"><path d="m17 2 4 4-4 4" /><path d="M3 11V9a3 3 0 0 1 3-3h15" /><path d="m7 22-4-4 4-4" /><path d="M21 13v2a3 3 0 0 1-3 3H3" /></symbol>
        <symbol id="i-close" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18" /></symbol>
        <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
        <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></symbol>
        <symbol id="i-download" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" /></symbol>
        <symbol id="i-filter" viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4" /></symbol>
        <symbol id="i-edit" viewBox="0 0 24 24"><path d="M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17zM13.5 8.5l2 2" /></symbol>
        <symbol id="i-trash" viewBox="0 0 24 24"><path d="M5 7h14M10 7V4.5h4V7M7 7l.8 12.2a1 1 0 0 0 1 .8h6.4a1 1 0 0 0 1-.8L17 7" /></symbol>
        <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 20H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h4M15 16l4-4-4-4M19 12H9" /></symbol>
        <symbol id="i-sparkles" viewBox="0 0 24 24"><path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z" /><path d="M20 3v4M22 5h-4M4 17v2M5 18H3" /></symbol>
        <symbol id="i-receipt" viewBox="0 0 24 24"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z" /><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8" /><path d="M12 17.5v-11" /></symbol>
        <symbol id="i-zap" viewBox="0 0 24 24"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" /></symbol>
    </svg>

    <div class="app-shell">
        @if (isUser)
        {
            <aside class="sidebar d-print-none" id="spendy-sidebar">
                <a asp-controller="User" asp-action="Dashboard" class="brand">
                    <div class="brand__mark"><span></span><span></span><span></span></div>
                    <span class="brand__name">Spendy</span>
                </a>

                <nav class="sidebar__nav" aria-label="Main navigation">
                    <p class="eyebrow sidebar__label">Workspace</p>
                    @foreach (var item in navItems)
                    {
                        var active = item.Action == current;
                        <a asp-controller="User" asp-action="@item.Action"
                           class="nav-item @(active ? "nav-item--active" : "")"
                           aria-current="@(active ? "page" : null)">
                            <svg class="i"><use href="#i-@item.Icon" /></svg>
                            <span>@item.Label</span>
                        </a>
                    }
                    <a asp-controller="User"
                       asp-action="Statement"
                       asp-route-month="@thisMonthIso"
                       class="nav-item @(current == "Statement" ? "nav-item--active" : "")"
                       aria-current="@(current == "Statement" ? "page" : null)">
                        <svg class="i"><use href="#i-download" /></svg>
                        <span>Print PDF</span>
                    </a>
                </nav>

                <div class="sidebar__bottom">
                    <div class="insight-card">
                        <span class="insight-card__icon">
                            <svg class="i" style="width:18px;height:18px"><use href="#i-goals" /></svg>
                        </span>
                        <p class="insight-card__title">@DateTime.Today.ToString("MMMM") insight</p>
                        <p class="insight-card__copy">Your spending rhythm and analytics are synced in real time.</p>
                        <a asp-controller="User" asp-action="Analytics" class="insight-card__link">
                            See your analytics
                            <svg class="i" style="width:15px;height:15px"><use href="#i-arrow-up-right" /></svg>
                        </a>
                    </div>

                    <a asp-controller="User" asp-action="Profile"
                       class="nav-item @(current == "Profile" ? "nav-item--active" : "")">
                        <svg class="i"><use href="#i-settings" /></svg>
                        <span>Settings</span>
                    </a>

                    <div class="profile">
                        <a asp-controller="User" asp-action="Profile" class="avatar" title="Profile (@name)">@initials</a>
                        <div class="min-w-0">
                            <p>@name</p>
                            <span>Personal account</span>
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="icon-btn" title="Logout" aria-label="Logout">
                                <svg class="i" style="width:16px;height:16px"><use href="#i-logout" /></svg>
                            </button>
                        </form>
                    </div>
                </div>
            </aside>

            <button type="button" class="scrim d-print-none" id="spendy-scrim" aria-label="Close navigation" hidden></button>
        }

        <main class="main">
            @if (isUser)
            {
                <header class="topbar d-print-none">
                    <div class="topbar__mobile-brand">
                        <button type="button" class="button button--icon" id="spendy-menu-btn" aria-label="Open navigation">
                            <svg class="i"><use href="#i-menu" /></svg>
                        </button>
                        <span class="brand__name">Spendy</span>
                    </div>
                    <div class="topbar__title">
                        <p class="eyebrow">@DateTime.Today.ToString("dddd, MMMM d")</p>
                        <h1>@(current == "Dashboard" ? $"{greeting}, {firstName}." : (ViewData["Title"] ?? "Overview"))</h1>
                    </div>
                    <div class="topbar__actions">
                        <form asp-controller="User" asp-action="Expenses" method="get" class="topbar__search m-0">
                            <svg class="i" style="width:16px;height:16px"><use href="#i-search" /></svg>
                            <input type="search"
                                   name="q"
                                   id="fd-global-search"
                                   placeholder="Search expenses (⌘K)"
                                   value="@Context.Request.Query["q"]"
                                   aria-label="Search expenses" />
                        </form>
                        <partial name="_ThemeToggle" model='"button button--icon theme-icon"' />
                        <a asp-controller="User" asp-action="Analytics" class="button button--icon notification-button" aria-label="Analytics" title="Analytics">
                            <svg class="i"><use href="#i-bell" /></svg>
                            <span class="notification-dot"></span>
                        </a>
                        <button type="button"
                                class="button button--primary"
                                data-expense data-id="0" data-date="@todayIso" data-paymentmode="0">
                            <svg class="i" style="width:18px;height:18px"><use href="#i-plus" /></svg>
                            <span>Add expense</span>
                        </button>
                    </div>
                </header>
            }

            @if (current == "Dashboard")
            {
                @RenderBody()
            }
            else
            {
                <div class="page-content">
                    @RenderBody()
                </div>
            }
        </main>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="toast-note d-print-none" role="status"><svg class="i" aria-hidden="true"><use href="#i-check" /></svg>@success</div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
