@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    // The admin's Home is the admin overview, so it gets no section links.
    (string Action, string Label, string Icon)[] links = signedIn && !User.IsInRole("Admin")
        ? [("Dashboard", "Overview", "home"), ("Expenses", "Expenses", "list"), ("Calendar", "Calendar", "calendar"), ("Analytics", "Analytics", "chart")]
        : [];
    var action = ViewContext.RouteData.Values["action"] as string;
    // The statement is opened from the calendar, so it stays in that section.
    var current = action == "Statement" ? "Calendar" : action;
    var name = User.Identity?.Name ?? "";
    var initials = string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExpenseTracker</title>
    <script type="importmap"></script>
    <partial name="_Theme" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400..700&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExpenseTracker.styles.css" asp-append-version="true" />
</head>
<body>
    <svg class="position-absolute" width="0" height="0" aria-hidden="true">
        <symbol id="i-home" viewBox="0 0 24 24"><path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1z" /></symbol>
        <symbol id="i-list" viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" /></symbol>
        <symbol id="i-calendar" viewBox="0 0 24 24"><rect x="4" y="5" width="16" height="15" rx="2.5" /><path d="M4 10h16M8.5 3v4M15.5 3v4" /></symbol>
        <symbol id="i-chart" viewBox="0 0 24 24"><path d="M4 20h16M7 16v-4M12 16V7M17 16v-6" /></symbol>
        <symbol id="i-user" viewBox="0 0 24 24"><circle cx="12" cy="8.5" r="3.5" /><path d="M5 20a7 7 0 0 1 14 0" /></symbol>
        <symbol id="i-logout" viewBox="0 0 24 24"><path d="M10 20H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h4M15 16l4-4-4-4M19 12H9" /></symbol>
        <symbol id="i-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4-4" /></symbol>
        <symbol id="i-edit" viewBox="0 0 24 24"><path d="M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17zM13.5 8.5l2 2" /></symbol>
        <symbol id="i-trash" viewBox="0 0 24 24"><path d="M5 7h14M10 7V4.5h4V7M7 7l.8 12.2a1 1 0 0 0 1 .8h6.4a1 1 0 0 0 1-.8L17 7" /></symbol>
        <symbol id="i-download" viewBox="0 0 24 24"><path d="M12 4v11M7.5 10.5 12 15l4.5-4.5M5 20h14" /></symbol>
        <symbol id="i-filter" viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M10 18h4" /></symbol>
        <symbol id="i-check"viewBox="0 0 24 24"><path d="m5 12.5 4.5 4.5L19 7.5" /></symbol>
    </svg>

    <div class="shell">
        <header class="topbar d-lg-none d-print-none">
            <a class="brand" asp-controller="User" asp-action="Index"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>ExpenseTracker</a>
            <button type="button" class="icon-btn" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Open menu">
                <svg class="i"><use href="#i-menu" /></svg>
            </button>
        </header>

        @* A drawer below 992px (Bootstrap offcanvas-lg), a fixed column above. *@
        <aside class="sidebar offcanvas-lg offcanvas-start d-print-none" id="sidebar" tabindex="-1" aria-label="Main menu">
            <div class="side-head">
                <a class="brand" asp-controller="User" asp-action="Index"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>ExpenseTracker</a>
                <button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Close menu"></button>
            </div>

            @if (links.Length > 0)
            {
                <nav class="side-nav">
                    @foreach (var l in links)
                    {
                        var active = l.Action == current;
                        <a class="side-link" asp-controller="User" asp-action="@l.Action" aria-current="@(active ? "page" : null)">
                            @if (active)
                            {
                                <i class="side-pill" aria-hidden="true"></i>
                            }
                            <svg class="i"><use href="#i-@l.Icon" /></svg>
                            @l.Label
                        </a>
                    }
                </nav>
            }

            <div class="side-foot">
                @if (signedIn)
                {
                    <div class="side-user">
                        <span class="avatar" aria-hidden="true">@initials</span>
                        <span class="text-truncate">@name</span>
                        <a class="icon-btn ms-auto" asp-controller="User" asp-action="Profile" aria-label="Profile" title="Profile" aria-current="@(current == "Profile" ? "page" : null)">
                            <svg class="i"><use href="#i-user" /></svg>
                        </a>
                    </div>
                }
                <partial name="_ThemeToggle" model='"side-link"' />
                @if (signedIn)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="side-link"><svg class="i"><use href="#i-logout" /></svg>Logout</button>
                    </form>
                }
            </div>
        </aside>

        <main class="content">
            <div class="page">
                @RenderBody()
            </div>
        </main>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="toast-note d-print-none" role="status"><svg class="i" aria-hidden="true"><use href="#i-check" /></svg>@success</div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
