@{
    var notFound = Context.Response.StatusCode == 404;
    ViewData["Title"] = notFound ? "Page not found" : "Error";
}

<div class="text-center py-5">
    <p class="display-1 fw-bold text-body-secondary">@(notFound ? "404" : "Oops")</p>
    <h1 class="h3">@(notFound ? "Page not found" : "Something went wrong")</h1>
    <p class="text-body-secondary">
        @(notFound
            ? "The page you're looking for doesn't exist or may have been moved."
            : "We couldn't complete your request. Please try again in a moment.")
    </p>
    <a asp-controller="User" asp-action="Index" class="btn btn-primary">Go to home</a>
</div>
